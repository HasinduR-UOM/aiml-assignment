{
  "name": "paddy-yield-sl",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {}
  },
  "hostRequirements": { "cpus": 4 },
  "postCreateCommand": "pip install --user uv==0.11.* && ~/.local/bin/uv sync --all-extras && az extension add -n ml -y",
  "forwardPorts": [8000, 8501],
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "ms-toolsai.jupyter", "charliermarsh.ruff", "ms-toolsai.vscode-ai"] }
  }
}
